# ----------------------------------------------------------------------------
# env.template: variables for the guides and the helper scripts.
# Copy to env.local, fill in every value, then load it in your shell:
#     set -a; source env.local; set +a
# Never publish env.local. Only this template is meant to be shared.
# ----------------------------------------------------------------------------

# --- Host and access (Part 1) -----------------------------------------------
# Admin login name on the box (not root).
ADMIN_USER=

# SSH port the server listens on (sshd Port).
SSH_PORT=

# Your tailnet name: the prefix in *.ts.net hostnames, e.g. "example-net".
TAILNET_NAME=

# The box's Tailscale address (tailscale0).
TS_IP=

# Your machine's Tailscale address, added to the fail2ban ignore list.
ADMIN_TS_IP=

# The box's LAN address (eth0). Used to confirm LAN access is blocked.
LAN_IP=

# Tag applied to the box and to the peers it needs to talk to, as set in the
# tailnet ACL, e.g. "tag:example".
TAG_PI_PEERS=

# Directory for root-only secret files (Part 2).
SECRETS_DIR=

# --- Public site (Part 2) ----------------------------------------------------
# Public hostname served through the Cloudflare Tunnel, without scheme.
PUBLIC_DOMAIN=

# Directory where Ghost is installed (where ghost-cli is run).
GHOST_DIR=

# systemd unit name for Ghost (ghost-cli creates it, usually ghost_<name>).
GHOST_UNIT=

# Local port Ghost listens on. The tunnel should point at this.
GHOST_PORT=

# Numeric uid the Ghost service runs as (systemctl show <unit> -p User).
GHOST_UID=

# --- Ghost database (Part 2) -------------------------------------------------
GHOST_DB_HOST=
GHOST_DB_NAME=
GHOST_DB_USER=

# --- Monitoring stack (Part 3) -----------------------------------------------
PROM_USER=
PROM_BIN_DIR=
PROM_CONF_DIR=
PROM_DATA_DIR=
PROM_PORT=
PROM_RETENTION=

NODE_EXPORTER_PORT=
NUT_EXPORTER_PORT=

# Full hostname Tailscale Serve exposes Grafana on, e.g. <service>.<tailnet>.ts.net.
GRAFANA_HOST=

# --- Schedules (Parts 1 and 2) ------------------------------------------------
# Daily AIDE check time, UTC, chosen to fall after your apt upgrade window.
AIDE_CHECK_TIME=

# Weekly ClamAV scan: day and time, UTC, chosen to be a quiet period.
CLAMAV_SCAN_DAY=
CLAMAV_SCAN_TIME=
